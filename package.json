{
  "name": "chromecast-direct-cast",
  "version": "0.1.0",
  "description": "Discover authorized HLS or DASH streams and cast them directly with catt.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdiloreto/chromecast-direct-cast.git"
  },
  "homepage": "https://github.com/mdiloreto/chromecast-direct-cast#readme",
  "bugs": {
    "url": "https://github.com/mdiloreto/chromecast-direct-cast/issues"
  },
  "keywords": [
    "catt",
    "chromecast",
    "dash",
    "hls",
    "m3u8"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "chromecast-direct-cast": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
